# =================================================================
# CourseMate AI — Unified Environment Configuration
# Copy this file to .env and insert your real credentials.
# Do NOT commit your actual .env file to version control.
# =================================================================

# Server & RAG Ports
PORT=5000
RAG_SERVICE_PORT=8000
RAG_HOST=0.0.0.0

# MongoDB Atlas Database URI (Do NOT replace with local container)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/coursemate?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Google Gemini API Key & Models
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-flash-latest
GEMINI_OCR_MODEL=gemini-3.5-flash-lite

# Cloudinary Storage for PDFs
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Python RAG Microservice URL (used by backend)
PYTHON_RAG_URL=http://rag-service:8000

# ChromaDB Data Storage Directory
CHROMA_DB_PATH=/app/chroma_db
