# =================================================================
# CourseMate AI — Backend Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# Do NOT commit your actual .env file with secrets to git.
# =================================================================

# Server Port
PORT=5000

# MongoDB Connection
# Set your MongoDB Atlas connection string (or use local: mongodb://127.0.0.1:27017/coursemate)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/coursemate?retryWrites=true&w=majority
# Alternative alias (for backwards compatibility):
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/coursemate?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Google Gemini API
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash

# Cloudinary Storage for PDFs
# Sign up at https://cloudinary.com (free tier available)
# Obtain Cloud Name, API Key, and API Secret from your Cloudinary Dashboard:
# IMPORTANT: Use the Primary/Root API Key shown on your Dashboard (or ensure custom Access Keys have "create" actions enabled).
# Note: Assigning Console user roles like "Media Library User" does not grant programmatic API upload permissions.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Python RAG Microservice URL
# URL of the CourseMate Python RAG service (running on port 8000)
PYTHON_RAG_URL=http://127.0.0.1:8000
RAG_SERVICE_PORT=8000
